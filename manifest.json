{
  "manifest_version": 3,
  "name": "Master SPA",
  "version": "0.9.7",
  "description": "Mapeia o DOM (com componentes React) e as chamadas fetch/XHR de uma SPA, exporta JSON e abre um painel de acoes.",
  "permissions": [
    "activeTab",
    "alarms",
    "downloads",
    "scripting",
    "storage",
    "unlimitedStorage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "scripts/inject_network.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "scripts/content_manager.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "scripts/inject_scanner.js",
        "scripts/inject_recorder.js",
        "scripts/fb_publisher.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "host_permissions": [
    "https://nca-gateway.fretebras.com.br/*",
    "https://sso-external.fretebras.com.br/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ]
}
